# --- data (too large / not part of the code) ---------------------------------------------
# masks: the 16 .tif files in mask_files/ are part of the repository (needed to run the pipeline);
# the raw shapefile folders (and duplicates) are not
/mask_files/*/
/GEOBON_results/
/GEOBON_uploading/*
!/GEOBON_uploading/json_files/
*.nc
*.zip

# --- generated by the pipeline (can be re-created with the scripts) -----------------------
/processing_scripts/logs/
/processing_scripts/array_prep*/
/processing_scripts/old_file_versions/
/processing_scripts/test_results/
/processing_scripts/qc_year_tasks/report/
# qc_year_tasks/flagged_days.csv and months_not_regular.csv stay in the repository (documentation)

# --- machine specific -----------------------------------------------------------------------
/processing_scripts/.Renviron

# --- R / OS clutter -------------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
__MACOSX/
.DS_Store
Thumbs.db